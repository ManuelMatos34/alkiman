# ── Variables de entorno del VPS ──────────────────────────────────────────────
# Copiar a /opt/alkiman/.env en el servidor y completar los valores reales.
# NUNCA commitear este archivo con valores reales.

# Dominio donde se despliega la app (sin https://)
DOMAIN=app.tu-dominio.com

# Docker Hub
DOCKER_USERNAME=tu_usuario_dockerhub
IMAGE_TAG=latest

# SQL Server
SA_PASSWORD=Cambia_esto_por_una_contrasena_segura!1

# Cadena de conexión (usa el nombre de servicio 'sqlserver' como host)
CONNECTION_STRING=Server=sqlserver,1433;Database=AlkimanDb;User Id=sa;Password=Cambia_esto_por_una_contrasena_segura!1;TrustServerCertificate=True

# JWT (mínimo 32 caracteres aleatorios)
JWT_SECRET=genera-una-clave-aleatoria-larga-aqui

# Stripe
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...

# Resend (email)
RESEND_API_KEY=re_...
EMAIL_FROM_ADDRESS=noreply@tu-dominio.com

# WhatsApp Business API
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
